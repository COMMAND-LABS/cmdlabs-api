LANGSMITH_ENDPOINT= # Endpoint for monitoring with LangSmith
LANGSMITH_API_KEY= # Your LangSmith API key
LANGCHAIN_API_KEY= # Optional; defaults to LANGSMITH_API_KEY when unset (src/utils/langsmith.py)
PINECONE_API_KEY= # Your Pinecone API key
PINECONE_ALL_MINILM_L6_V2_INDEX= # Name of your `ALL_MINILM_L6_V2` Pinecone index
EMBEDDINGS_API_URL= # URL of your self-hosted embeddings API
POSTGRES_URL= # URL of your PostgreSQL database ie: Supabase, Render, etc.
DB_SSLMODE= # Optional; defaults to "require". Set to "disable" for a local Postgres container

AUTH_SECRET_KEY="<SECRET_KEY>" # Secret key for JWT
AUTH_ALGORITHM="HS256" # Algorithm for JWT

COOKIE_DOMAIN=localhost # Domain for HTTP-only cookies set by the server

AWS_REGION= # AWS region
AWS_ACCESS_KEY_ID= # AWS access key
AWS_SECRET_KEY= # AWS secret key

TRACKING_BASE_URL=http://127.0.0.1:4000 # Public base URL for email open-tracking pixels & star-rating links (prod: https://api.cmdlabs.io). No trailing slash — code appends /t/o/<id> and /t/r/<id>

KB_INGEST_SA= # Path to your Google Cloud Service Account JSON file (in production: the JSON itself)
GOOGLE_CLOUD_PROJECT= # Optional; Google Cloud project for GCS uploads, defaults to "command-labs"

ENVIRONMENT= # Environment ie: local, staging, production

STRIPE_SECRET_KEY= # Stripe Creds
STRIPE_MEMBER_PRICE_ID= # Recurring price for the $19/mo Member plan, ie: price_xxx
STRIPE_WEBHOOK_SECRET= # Signing secret for /api/billing/webhook, ie: whsec_xxx (stripe listen prints one for local dev)

APP_BASE_URL= # Public URL of the UI, used to build Stripe Checkout return URLs and the /resources link in lead magnet emails, ie: http://localhost:3001

LOG_LEVEL= # Optional; defaults to INFO
# --- Agent runtime (merged from cmdlabs-agent-api) ---

CREDENTIALS_ENCRYPTION_KEY= # urlsafe-base64 32-byte Fernet key; the credentials cipher FAILS FAST without a valid one (no silent fallback)
CREDENTIALS_ENCRYPTION_KEY_OLD= # Optional; previous key, only set while rotating (scripts/README_credentials_key_rotation.md)

RERANKER_API_URL= # Reranker service used by the agent vector-search tool
OLLAMA_BASE_URL= # Optional; defaults to http://localhost:11434

RUNNER_URL= # Optional; cmdlabs-runner URL. Unset = the timeSeriesForecast and codeExecution tools are skipped
RUNNER_AUTH_MODE= # Optional; defaults to "iam" (Google ID token)

DUMP_AGENT_PROMPT= # Optional; 1/true/yes writes each run's full prompt to disk (off by default)
DUMP_AGENT_PROMPT_DIR= # Optional; where prompt dumps are written

NAMESPACE_FILE_SCAN_CAP= # Optional; defaults to 10000

# SQLAlchemy pool tuning (defaults in src/db/database.py; prod values in service.yaml)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# Optional max number of accounts; unset or 0 = unlimited
SIGNUP_CAP=
