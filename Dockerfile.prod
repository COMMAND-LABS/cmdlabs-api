FROM python:3.12-slim

RUN apt-get update && apt-get install -y curl git build-essential net-tools iproute2 libpq-dev zlib1g-dev

# Install uv
# Pinned, so a new uv release cannot change how the image resolves or installs.
COPY --from=ghcr.io/astral-sh/uv:0.12.3 /uv /usr/local/bin/uv

ENV PYTHONUNBUFFERED=True

# set the working directory
WORKDIR /code

# Install EXACTLY the locked versions CI tested (uv.lock), hash-verified, and
# without the dev group (pytest, debugpy). Resolving from pyproject's version
# ranges instead would let a production build pick up releases CI never ran.
# The project itself is not installed: the app runs from ./src via PYTHONPATH.
COPY ./pyproject.toml ./uv.lock ./
RUN uv export --frozen --no-dev --no-emit-project -o /tmp/requirements.txt > /dev/null \
    && uv pip install --system --no-cache --require-hashes -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

# copy src code
COPY ./src ./src

ENV PYTHONPATH=/code

EXPOSE 8080

# start the server
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8080", "--proxy-headers"]